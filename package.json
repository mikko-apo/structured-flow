{
  "name": "structured-flow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\" && tsc -p .",
    "update-readme": "node --experimental-strip-types --experimental-transform-types src/demos/updateReadme.ts",
    "build": "npm run lint && npm run typecheck && npm run update-readme && npm run bundle && npm run format",
    "dev": "tsc -w -p .",
    "format": "prettier --write .",
    "lint": "eslint",
    "test": "vitest",
    "test-console": "vitest --disableConsoleIntercept=false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "eslint": "10.4.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vitest": "4.1.6"
  }
}
